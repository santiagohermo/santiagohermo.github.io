@techreport{HermoSidicaroTrombetta2026,
  title    = {Firms and the Fragility of Inequality Reduction: Evidence from Argentina},
  author   = {Hermo, Santiago and Sidicaro, Nicolás and Trombetta, Martín},
  year     = {2026},
  month    = {09},
  abstract = {Earnings inequality in Latin America fell during the 2000s and stagnated in the 2010s,
              with cross-country inequality reversals associated with growth slowdowns. 
              Using Argentine matched employer-employee data, we show that firm wage premia compressed
              in the 2000s and dispersed in the 2010s. 
              Rising firm-effect dispersion drove Argentina's inequality reversal, which was 
              concentrated among smaller firms. Worker-effect dispersion fell in the 2000s without 
              subsequently increasing. 
              The reversal coincided with declining productivity and weakening negotiated wage floors 
              and was correlated with informality.
              These findings suggest that macroeconomic stagnation can reverse inequality reduction 
              by allowing low-paying firms to fall behind.},
  ssrn        = {https://ssrn.com/abstract=7539702},
  pdf = {HST_2026_FragilityInequalityDecline.pdf},
  group = {Working papers},
  bibtex_show = {true}
}

@techreport{BDHL2026,
  author      = {Bhuller, Manudeep and Delgado-Prieto, Lukas and Hermo, Santiago and Lorentzen, Linnea},
  title       = {Wage-Setting Constraints and Firm Responses to Demand Shocks},
  year        = {2026},
  month       = {06},
  type        = {Available at SSRN: \url{https://ssrn.com/abstract=5954516}},
  group       = {Working papers},
  ssrn        = {https://ssrn.com/abstract=5954516},
  arxiv       = {2512.19622},
  url         = {https://ssrn.com/abstract=5954516},
  bibtex_show = {true},
  abstract = {
    This paper investigates how institutional wage-setting constraints, such as a national 
    minimum wage or collectively bargained wages, affect firm responses to demand shocks.
    We develop a framework to interpret heterogeneous shock responses that depend on the 
    constraints firms face, and provide empirical evidence on the relevance of these 
    constraints in shaping firm behavior across three countries with different institutional 
    settings: Portugal, Norway, and Colombia.
    We discuss the implications of our findings for conventional measures of employer 
    wage-setting power and rent-sharing.}
}

